<!DOCTYPE html>
<html lang="id">
<head>
  <%- include("partials/head", { title: "Leaderboard" }) %>
</head>
<body>
  <div class="layout">
    <%- include("partials/sidebar") %>

    <main class="content">
      <header class="content-header">
        <h1>Leaderboard</h1>
        <p class="subtitle">Top 10 user dengan level tertinggi</p>
      </header>

      <section class="panel glass">
        <div class="panel-header">
          <h2>Ranking</h2>
          <form method="GET" action="/leaderboard" class="guild-select-form">
            <select name="guild" onchange="this.form.submit()">
              <% guilds.forEach(g => { %>
                <option value="<%= g.id %>" <%= g.id === selectedGuild ? "selected" : "" %>><%= g.name %></option>
              <% }) %>
            </select>
          </form>
        </div>

        <div class="leaderboard-list">
          <% if (leaderboard.length === 0) { %>
            <p class="empty-row">Belum ada data leaderboard di server ini.</p>
          <% } %>
          <% leaderboard.forEach((u, i) => { %>
            <div class="lb-row <%= i < 3 ? 'lb-top' : '' %>">
              <span class="lb-rank"><%= i === 0 ? "🥇" : i === 1 ? "🥈" : i === 2 ? "🥉" : `#${i + 1}` %></span>
              <span class="lb-user"><code><%= u.userId %></code></span>
              <span class="lb-level badge">Lv. <%= u.level %></span>
              <span class="lb-xp"><%= u.totalXp %> XP</span>
            </div>
          <% }) %>
        </div>
      </section>
    </main>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
