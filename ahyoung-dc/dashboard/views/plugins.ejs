<!DOCTYPE html>
<html lang="id">
<head>
  <%- include("partials/head", { title: "Plugins" }) %>
</head>
<body>
  <div class="layout">
    <%- include("partials/sidebar") %>

    <main class="content">
      <header class="content-header">
        <h1>Plugins</h1>
        <p class="subtitle">Kelola plugin bot — hot-reload otomatis, tidak perlu restart</p>
      </header>

      <section class="panel glass">
        <div class="panel-header">
          <h2>Tambah Plugin Baru</h2>
        </div>

        <form id="addPluginForm" class="add-plugin-form">
          <div class="form-row">
            <div class="form-group">
              <label>Kategori</label>
              <input type="text" name="category" list="categoryList" placeholder="general / fun / owner / ..." required />
              <datalist id="categoryList">
                <% categories.forEach(c => { %><option value="<%= c %>"></option><% }) %>
              </datalist>
            </div>
            <div class="form-group">
              <label>Nama Plugin</label>
              <input type="text" name="name" placeholder="contoh: hello" required />
            </div>
          </div>
          <div class="form-group">
            <label>Code (ESM, `export default { name, run }`)</label>
            <textarea name="code" rows="10" placeholder="export default {&#10;  name: &quot;hello&quot;,&#10;  category: &quot;General&quot;,&#10;  async run({ message }) {&#10;    await message.reply(&quot;Halo!&quot;)&#10;  }&#10;}" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">➕ Simpan Plugin</button>
          <span id="addPluginMsg" class="form-msg"></span>
        </form>
      </section>

      <section class="panel glass">
        <div class="panel-header">
          <h2>Plugin Terpasang (<%= plugins.length %>)</h2>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Status</th>
                <th>Nama</th>
                <th>Kategori</th>
                <th>Alias</th>
                <th>Konteks</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% plugins.forEach(p => { %>
                <tr>
                  <td><span class="badge <%= p.loaded ? 'badge-success' : 'badge-warn' %>"><%= p.loaded ? "Aktif" : "Gagal" %></span></td>
                  <td><code><%= p.name %></code></td>
                  <td><%= p.category %></td>
                  <td><%= p.aliases.join(", ") || "-" %></td>
                  <td><%= p.guildOnly ? "🛡️ Server" : "🌐 Server & DM" %></td>
                  <td class="actions-cell">
                    <button class="btn btn-ghost btn-sm" onclick="viewPluginSource('<%= p.name %>')">Lihat</button>
                    <button class="btn btn-danger btn-sm" onclick="deletePlugin('<%= p.name %>')">Hapus</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <div id="sourceModal" class="modal hidden">
    <div class="modal-box glass">
      <div class="modal-header">
        <h3 id="sourceModalTitle">Source</h3>
        <button onclick="closeModal()" class="btn btn-ghost btn-sm">✕</button>
      </div>
      <pre id="sourceModalCode" class="code-view"></pre>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
