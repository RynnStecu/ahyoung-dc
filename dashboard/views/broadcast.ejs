<!DOCTYPE html>
<html lang="id">
<head>
  <%- include("partials/head", { title: "Broadcast" }) %>
</head>
<body>
  <div class="layout">
    <%- include("partials/sidebar") %>

    <main class="content">
      <header class="content-header">
        <h1>Broadcast</h1>
        <p class="subtitle">Kirim pesan ke semua server dan/atau semua user yang pernah tercatat bot</p>
      </header>

      <section class="panel glass">
        <div class="broadcast-targets">
          <div class="mini-stat">
            <span class="stat-label">Total Server</span>
            <span class="stat-value"><%= totalServers %></span>
          </div>
          <div class="mini-stat">
            <span class="stat-label">Total User Ter-track</span>
            <span class="stat-value"><%= totalUsers %></span>
          </div>
        </div>

        <form id="broadcastForm" class="broadcast-form">
          <div class="form-group">
            <label>Target</label>
            <div class="radio-group">
              <label class="radio-pill"><input type="radio" name="target" value="servers" checked /> Server saja</label>
              <label class="radio-pill"><input type="radio" name="target" value="users" /> User saja (DM)</label>
              <label class="radio-pill"><input type="radio" name="target" value="both" /> Server + User</label>
            </div>
          </div>

          <div class="form-group">
            <label>Pesan</label>
            <textarea name="message" rows="6" placeholder="Tulis pesan broadcast di sini..." required></textarea>
          </div>

          <button type="submit" class="btn btn-primary" id="broadcastSubmit">📢 Kirim Broadcast</button>
          <span id="broadcastMsg" class="form-msg"></span>
        </form>

        <div id="broadcastResult" class="broadcast-result hidden"></div>
      </section>
    </main>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
